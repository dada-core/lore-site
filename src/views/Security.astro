---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import PageHero from '../components/PageHero.astro';
import CheckList from '../components/CheckList.astro';
import { GITHUB } from '../config';
import type { Release } from '../data/modules';
import { docHref } from '../docs/nav';
import { REPORT_ANCHOR, type Lang } from '../i18n/routes';
import type { IconName } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/* What already works is written in the present tense; what comes with the documents carries its release. */
type Card = [icon: string, title: string, text: string];
type PlannedCard = [icon: string, title: string, text: string, release: Release];

const T = {
  fr: {
    title: 'Sécurité',
    description: 'Comptes protégés, droits appliqués dans chaque requête, fichiers non fiables traités à part, journal d’audit, données chez vous, code ouvert : la sécurité de Lore.',
    h1: 'Conçu pour héberger de la documentation sensible.',
    lead: 'Procédures d’exploitation, schémas d’infrastructure, rapports d’incident : Lore part du principe que vos documents sont confidentiels, et que personne ne doit voir ce qu’il n’a pas le droit de voir.',
    now: {
      h2: 'Déjà en place',
      cards: [
        ['key', 'Comptes protégés', 'Mots de passe hachés avec Argon2id, tentatives de connexion limitées puis bloquées 15 minutes par défaut, sessions côté serveur que chacun peut fermer à distance, aucun mot de passe par défaut.'],
        ['lock', 'Les permissions d’abord', 'Les droits sont appliqués dans chaque requête, avant le tri et la pagination. Ni un titre, ni un extrait, ni un nombre de résultats ne trahit un document inaccessible.'],
        ['eye-off', 'Introuvable, au sens strict', 'Un document auquel vous n’avez pas accès renvoie la même réponse qu’un document qui n’existe pas : ni son titre, ni son contenu, ni sa place dans les résultats ne vous sont montrés. Les quelques indices indirects qui subsistent sont décrits dans la documentation.'],
        ['scan', 'Fichiers non fiables traités à part', 'L’extraction du texte s’exécute dans des processus séparés, sans les secrets de l’application, et Lore nettoie ce qu’il en reçoit : un fichier qui fait planter ou boucler l’extraction ne fait pas tomber l’application. Ces processus tournent encore sous le compte de Lore ; un compte dédié est prévu après la v0.1.'],
        ['list', 'Journal d’audit', 'Connexions, invitations, rôles, réglages de l’organisation, imports, versions, statuts, consultations, téléchargements et droits des documents sont enregistrés. Les administrateurs le consultent et l’exportent depuis l’administration.'],
        ['search', 'Recherches confidentielles', 'Ce que vous cherchez n’est gardé ni au journal d’audit, ni dans les journaux du serveur. Vos recherches récentes restent dans votre navigateur, et s’effacent à la déconnexion.'],
        ['check-circle', 'Vérifié à chaque modification', 'Des tests automatiques vérifient les comptes, les sessions, et qui voit quel document, dans quels résultats de recherche, pour chaque rôle, à chaque modification du code.'],
        ['server', 'Vos données chez vous', 'Lore s’héberge dans votre infrastructure, avec PostgreSQL. Rien n’est envoyé à l’extérieur sans votre décision.'],
        ['code', 'Code ouvert et auditable', 'Le code est public. Vos équipes de sécurité peuvent le relire, le tester et le compiler elles-mêmes.']
      ] as Card[]
    },
    planned: {
      h2: 'Prévu dans les prochaines versions',
      intro: 'Ces protections arrivent avec les fonctions qu’elles protègent.',
      cards: [
        ['chart', 'Recherches sans résultat', 'Le tableau de bord comptera les recherches sans résultat, pour montrer les lacunes de la documentation, sans les rattacher à la personne qui les a faites.', 'v0.2'],
        ['ask', 'Un assistant sous contrôle', 'Désactivé par défaut. Une fois activé, il ne recevra que les passages autorisés pour la personne qui pose la question.', 'v0.3']
      ] as PlannedCard[]
    },
    report: {
      h2: 'Signaler une vulnérabilité',
      intro: 'Ne signalez jamais une faille dans un ticket public. Utilisez le signalement privé de GitHub : nous accusons réception, vous tenons informé et vous créditons si vous le souhaitez.',
      button: 'Signaler une vulnérabilité',
      docs: 'Sécurité dans la documentation',
      card: 'Pour un signalement utile',
      items: ['Une description du problème et de son impact.', 'Les étapes pour le reproduire, ou une preuve de concept.', 'La version ou le commit concerné.']
    }
  },
  en: {
    title: 'Security',
    description: 'Protected accounts, permissions in every query, untrusted files kept apart, audit log, your data on your servers, open code: security in Lore.',
    h1: 'Built to hold sensitive documentation.',
    lead: 'Operating procedures, infrastructure diagrams, incident reports: Lore assumes your documents are confidential, and that nobody should see what they are not allowed to see.',
    now: {
      h2: 'Already in place',
      cards: [
        ['key', 'Protected accounts', 'Passwords hashed with Argon2id, rate-limited sign-in attempts, then blocked for 15 minutes by default, server-side sessions that everyone can end remotely, no default password.'],
        ['lock', 'Permissions first', 'Permissions are enforced in every query, before sorting and pagination. Not a title, not an excerpt, not a result count gives away an inaccessible document.'],
        ['eye-off', 'Truly unfindable', 'A document you cannot access returns the same response as a document that does not exist: you are shown neither its title, nor its content, nor its place in the results. The few indirect clues that remain are described in the documentation.'],
        ['scan', 'Untrusted files kept apart', 'Text extraction runs in separate processes, without the application’s secrets, and Lore cleans what it receives from them: a file that crashes or hangs the extraction does not bring the application down. These processes still run under Lore’s account; a dedicated account is planned after v0.1.'],
        ['list', 'Audit log', 'Sign-ins, invitations, roles, organization settings, and the imports, versions, statuses, views, downloads and permissions of documents are recorded. The administrators browse and export it from the administration.'],
        ['search', 'Private searches', 'What you search for is kept neither in the audit log nor in the logs of the server. Your recent searches stay in your browser, and are cleared when you sign out.'],
        ['check-circle', 'Checked on every change', 'Automated tests check accounts, sessions, and who sees which document, in which search results, for each role, on every code change.'],
        ['server', 'Your data stays with you', 'Lore runs in your infrastructure, with PostgreSQL. Nothing is sent outside without your decision.'],
        ['code', 'Open, auditable code', 'The code is public. Your security teams can review it, test it and build it themselves.']
      ] as Card[]
    },
    planned: {
      h2: 'Coming in the next releases',
      intro: 'These protections arrive with the features they protect.',
      cards: [
        ['chart', 'Searches with no results', 'The dashboard will count searches with no results, to show the gaps in the documentation, without tying them to the person who made them.', 'v0.2'],
        ['ask', 'An assistant under control', 'Off by default. Once enabled, it will only receive the passages the person asking is allowed to read.', 'v0.3']
      ] as PlannedCard[]
    },
    report: {
      h2: 'Report a vulnerability',
      intro: 'Never report a vulnerability in a public issue. Use GitHub’s private vulnerability reporting: we acknowledge your report, keep you informed and credit you if you wish.',
      button: 'Report a vulnerability',
      docs: 'Security in the documentation',
      card: 'For a useful report',
      items: ['A description of the problem and its impact.', 'The steps to reproduce it, or a proof of concept.', 'The affected version or commit.']
    }
  }
}[lang];
const securityDocs = docHref('security', lang);
---
<Base lang={lang} page="security" title={T.title} description={T.description}>
  <PageHero kicker={T.title} icon="shield" title={T.h1} lead={T.lead} />
  <section class="s-sec-tight s-sec-flush">
    <div class="s-wrap">
      <div class="s-head"><h2 class="s-h2">{T.now.h2}</h2></div>
      <div class="s-cards">
        {T.now.cards.map(([icon, title, text]) => <div class="s-card"><span class="s-ico-box"><Icon name={icon as IconName} /></span><h3>{title}</h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="s-sec s-sec-alt">
    <div class="s-wrap">
      <div class="s-head">
        <h2 class="s-h2">{T.planned.h2}</h2>
        <p class="s-intro">{T.planned.intro}</p>
      </div>
      <div class="s-cards s-cards-2">
        {T.planned.cards.map(([icon, title, text, release]) => <div class="s-card"><span class="s-ico-box"><Icon name={icon as IconName} /></span><h3>{title} <Badge lang={lang} v={release} /></h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="s-sec" id={REPORT_ANCHOR} style="scroll-margin-top:70px">
    <div class="s-wrap s-split">
      <div>
        <h2 class="s-h2">{T.report.h2}</h2>
        <p class="s-intro">{T.report.intro}</p>
        <div class="s-ctas">
          <a class="btn btn-primary s-md" href={GITHUB.security}><Icon name="bug" />{T.report.button}</a>
          <a class="btn s-md" href={securityDocs}>{T.report.docs}</a>
        </div>
      </div>
      <div class="s-card">
        <h3>{T.report.card}</h3>
        <CheckList items={T.report.items} tight />
      </div>
    </div>
  </section>
</Base>
