---
/* Document status, with round icons. */
import type { Lang } from '../i18n/routes';
import { ui } from '../i18n/ui';

type S = 'draft' | 'published' | 'obsolete' | 'review' | 'validated';
interface Props {
  lang: Lang;
  s: S;
}
const { lang, s } = Astro.props;
const color = { draft: 'var(--st-draft)', review: 'var(--st-review)', obsolete: 'var(--st-obsolete)', published: 'var(--st-published)', validated: 'var(--st-published)' }[s];
---
<span class="status">
  <svg class="st-ico" viewBox="0 0 14 14" aria-hidden="true">
    {s === 'draft' && <circle cx="7" cy="7" r="5.5" fill="none" stroke={color} stroke-width="1.5" stroke-dasharray="2.3 1.9" />}
    {s === 'review' && <Fragment><circle cx="7" cy="7" r="5.5" fill="none" stroke={color} stroke-width="1.5" /><path d="M7 3.6a3.4 3.4 0 0 1 0 6.8z" fill={color} /></Fragment>}
    {s === 'obsolete' && <Fragment><circle cx="7" cy="7" r="5.5" fill="none" stroke={color} stroke-width="1.5" /><path d="M3.4 10.6 10.6 3.4" stroke={color} stroke-width="1.5" /></Fragment>}
    {(s === 'published' || s === 'validated') && <Fragment><circle cx="7" cy="7" r="6.25" fill={color} /><path d="m4.4 7.2 1.8 1.8 3.5-3.7" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></Fragment>}
  </svg>{ui(lang).status[s]}
</span>
