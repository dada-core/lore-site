---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import PageHero from '../components/PageHero.astro';
import CheckList from '../components/CheckList.astro';
import { GITHUB } from '../config';
import type { Release } from '../data/modules';
import { docHref } from '../docs/nav';
import { REPORT_ANCHOR, type Lang } from '../i18n/routes';
import type { IconName } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/* What already works is written in the present tense; what comes with the documents carries its release. */
type Card = [icon: string, title: string, text: string];
type PlannedCard = [icon: string, title: string, text: string, release: Release];

const T = {
  fr: {
    title: 'Sécurité',
    description: 'Comptes protégés, journal d’audit, données chez vous, code ouvert, et les protections prévues pour les documents : la sécurité de Lore.',
    h1: 'Conçu pour héberger de la documentation sensible.',
    lead: 'Procédures d’exploitation, schémas d’infrastructure, rapports d’incident : Lore part du principe que vos documents sont confidentiels, et que personne ne doit voir ce qu’il n’a pas le droit de voir.',
    now: {
      h2: 'Déjà en place',
      cards: [
        ['key', 'Comptes protégés', 'Mots de passe hachés avec Argon2id, tentatives de connexion limitées puis compte verrouillé, sessions côté serveur que chacun peut fermer à distance, aucun mot de passe par défaut.'],
        ['list', 'Journal d’audit', 'Connexions, échecs de connexion, changements de mot de passe et d’adresse, invitations, rôles, membres et réglages de l’organisation sont enregistrés. Sa consultation dans l’administration arrive en v0.1, avec les opérations sur les documents.'],
        ['check-circle', 'Vérifié à chaque modification', 'Des tests automatiques vérifient les comptes, les sessions et qui a le droit d’appeler l’API d’administration, à chaque modification du code.'],
        ['server', 'Vos données chez vous', 'Lore s’héberge dans votre infrastructure, avec PostgreSQL. Rien n’est envoyé à l’extérieur sans votre décision.'],
        ['code', 'Code ouvert et auditable', 'Le code est public. Vos équipes de sécurité peuvent le relire, le tester et le compiler elles-mêmes.']
      ] as Card[]
    },
    planned: {
      h2: 'Prévu dans les prochaines versions',
      intro: 'Ces protections arrivent avec les fonctions qu’elles protègent.',
      cards: [
        ['lock', 'Les permissions d’abord', 'Les droits seront appliqués dans chaque requête, avant le tri et la pagination. Ni un titre, ni un extrait, ni un nombre de résultats ne trahira un document inaccessible.', 'v0.1'],
        ['eye-off', 'Introuvable, au sens strict', 'Un document auquel vous n’avez pas accès renverra la même réponse qu’un document qui n’existe pas. Son existence même restera confidentielle.', 'v0.1'],
        ['scan', 'Fichiers non fiables isolés', 'L’extraction du texte s’exécutera dans un processus séparé : un fichier piégé ne pourra pas faire tomber l’application.', 'v0.1'],
        ['ask', 'Un assistant sous contrôle', 'Désactivé par défaut. Une fois activé, il ne recevra que les passages autorisés pour la personne qui pose la question.', 'v0.3']
      ] as PlannedCard[]
    },
    report: {
      h2: 'Signaler une vulnérabilité',
      intro: 'Ne signalez jamais une faille dans un ticket public. Utilisez le signalement privé de GitHub : nous accusons réception, vous tenons informé et vous créditons si vous le souhaitez.',
      button: 'Signaler une vulnérabilité',
      docs: 'Sécurité dans la documentation',
      card: 'Pour un signalement utile',
      items: ['Une description du problème et de son impact.', 'Les étapes pour le reproduire, ou une preuve de concept.', 'La version ou le commit concerné.']
    }
  },
  en: {
    title: 'Security',
    description: 'Protected accounts, audit log, your data on your servers, open code, and the protections planned for documents: security in Lore.',
    h1: 'Built to hold sensitive documentation.',
    lead: 'Operating procedures, infrastructure diagrams, incident reports: Lore assumes your documents are confidential, and that nobody should see what they are not allowed to see.',
    now: {
      h2: 'Already in place',
      cards: [
        ['key', 'Protected accounts', 'Passwords hashed with Argon2id, rate-limited sign-in attempts followed by a lockout, server-side sessions that everyone can end remotely, no default password.'],
        ['list', 'Audit log', 'Sign-ins, failed sign-ins, password and email changes, invitations, roles, members and organization settings are recorded. Browsing it in the administration comes in v0.1, along with document operations.'],
        ['check-circle', 'Checked on every change', 'Automated tests check accounts, sessions and who may call the administration API, on every code change.'],
        ['server', 'Your data stays with you', 'Lore runs in your infrastructure, with PostgreSQL. Nothing is sent outside without your decision.'],
        ['code', 'Open, auditable code', 'The code is public. Your security teams can review it, test it and build it themselves.']
      ] as Card[]
    },
    planned: {
      h2: 'Coming in the next releases',
      intro: 'These protections arrive with the features they protect.',
      cards: [
        ['lock', 'Permissions first', 'Permissions will be enforced in every query, before sorting and pagination. Not a title, not an excerpt, not a result count will give away an inaccessible document.', 'v0.1'],
        ['eye-off', 'Truly unfindable', 'A document you cannot access will return the same response as a document that does not exist. Even its existence will stay confidential.', 'v0.1'],
        ['scan', 'Untrusted files kept apart', 'Text extraction will run in a separate process: a booby-trapped file will not be able to bring the application down.', 'v0.1'],
        ['ask', 'An assistant under control', 'Off by default. Once enabled, it will only receive the passages the person asking is allowed to read.', 'v0.3']
      ] as PlannedCard[]
    },
    report: {
      h2: 'Report a vulnerability',
      intro: 'Never report a vulnerability in a public issue. Use GitHub’s private vulnerability reporting: we acknowledge your report, keep you informed and credit you if you wish.',
      button: 'Report a vulnerability',
      docs: 'Security in the documentation',
      card: 'For a useful report',
      items: ['A description of the problem and its impact.', 'The steps to reproduce it, or a proof of concept.', 'The affected version or commit.']
    }
  }
}[lang];
const securityDocs = docHref('security', lang);
---
<Base lang={lang} page="security" title={T.title} description={T.description}>
  <PageHero kicker={T.title} icon="shield" title={T.h1} lead={T.lead} />
  <section class="s-sec-tight s-sec-flush">
    <div class="s-wrap">
      <div class="s-head"><h2 class="s-h2">{T.now.h2}</h2></div>
      <div class="s-cards">
        {T.now.cards.map(([icon, title, text]) => <div class="s-card"><span class="s-ico-box"><Icon name={icon as IconName} /></span><h3>{title}</h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="s-sec s-sec-alt">
    <div class="s-wrap">
      <div class="s-head">
        <h2 class="s-h2">{T.planned.h2}</h2>
        <p class="s-intro">{T.planned.intro}</p>
      </div>
      <div class="s-cards s-cards-2">
        {T.planned.cards.map(([icon, title, text, release]) => <div class="s-card"><span class="s-ico-box"><Icon name={icon as IconName} /></span><h3>{title} <Badge lang={lang} v={release} /></h3><p>{text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="s-sec" id={REPORT_ANCHOR} style="scroll-margin-top:70px">
    <div class="s-wrap s-split">
      <div>
        <h2 class="s-h2">{T.report.h2}</h2>
        <p class="s-intro">{T.report.intro}</p>
        <div class="s-ctas">
          <a class="btn btn-primary s-md" href={GITHUB.security}><Icon name="bug" />{T.report.button}</a>
          <a class="btn s-md" href={securityDocs}>{T.report.docs}</a>
        </div>
      </div>
      <div class="s-card">
        <h3>{T.report.card}</h3>
        <CheckList items={T.report.items} tight />
      </div>
    </div>
  </section>
</Base>
